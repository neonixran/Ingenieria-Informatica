<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ventas.VentasActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragListado2"
        android:name="com.example.appspinner.listado.ListaFragment"
        android:layout_width="400dp"
        android:layout_height="425dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragInsertarVenta"
        tools:layout="@layout/fragment_lista" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragInsertarVenta"
        android:name="com.example.appspinner.ventas.VentaInsertarFragment"
        android:layout_width="400dp"
        android:layout_height="225dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/fragListado2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnVolverVenta"
        tools:layout="@layout/fragment_venta_insertar" />

    <Button
        android:id="@+id/btnVolverVenta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:text="Volver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>